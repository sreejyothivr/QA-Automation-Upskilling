<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Sanity Test Suite">

    <listeners>
        <listener class-name="testComponents.TestListener"/>
    </listeners>

    <test name="Login Test">
        <classes>
            <class name="testCases.LoginTest">
                <methods>
                    <include name="verifyValidLogin"/>
                    <include name="verifyInValidLogin"/>
                    <include name="verifyLoginWithValidUserAndInvalidPassword"/>
                    <include name="verifyLoginWithInvalidUserAndInvalidPassword"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Product Test">
        <classes>
            <class name="testCases.ProductTest">
                <methods>
                    <include name="verifySortingField"/>
                    <include name="verifySortingOptions"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>