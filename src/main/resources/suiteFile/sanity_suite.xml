<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Sanity Test Suite">

    <listeners>
        <listener class-name="testComponents.TestListener"/>
    </listeners>

    <test name="Login Test">
        <classes>
            <class name="testCases.LoginTest">
                <methods>
                    <include name="verifyValidLogin"/>
                    <include name="verifyInValidLogin"/>
                    <include name="verifyLoginWithValidUserAndInvalidPassword"/>
                    <include name="verifyLoginWithInvalidUserAndInvalidPassword"/>
                    <include name="verifyLoginWithEmptyUsernameAndPassword"/>
                    <include name="verifyUsernameAndPasswordPlaceholders"/>


                </methods>
            </class>
        </classes>
    </test>

    <test name="Product Test">
        <classes>
            <class name="testCases.ProductTest">
                <methods>
                    <include name="verifySortingField"/>
                    <include name="verifySortingOptions"/>
                    <include name="verifyHamburgerNavigationMenu"/>
                    <include name="verifyAllItemsNavigationToProductsPage"/>
                    <include name="verifyCloseButtonFunctionality"/>
                    <include name="verifyAboutNavigation"/>
                    <include name="verifyProductDetails"/>

                </methods>
            </class>
        </classes>
    </test>

    <test name="Cart Test">
        <classes>
            <class name="testCases.CartTest">
                <methods>
                    <include name="verifyProductsRemainInCart"/>
                    <include name="verifyCartBadgeCount"/>
                    <include name="verifyNavigationToProductDetailsPage"/>
                    <include name="verifyRemoveFromCart"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>